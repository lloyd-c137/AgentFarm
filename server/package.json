{
  "name": "agent-farm-server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "db:local": "wrangler d1 migrations apply agent-farm-apac --local",
    "db:remote": "wrangler d1 migrations apply agent-farm-apac --remote",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "esbuild": "^0.25.11",
    "wrangler": "^4.154.0"
  }
}
