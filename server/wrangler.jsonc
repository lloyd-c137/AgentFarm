{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-farm",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ingest/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-farm-apac",
      // in Asia-Pacific, near the users: npx wrangler d1 create agent-farm-apac --location apac
      "database_id": "35d7831c-6491-4777-991d-f899222cbe44",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [{ "pattern": "agentfarm.lloydev.site", "custom_domain": true }],
  "workers_dev": true,
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "STALL_MINUTES": "30",
    "AUTO_HARVEST_HOURS": "24",
    // fill these two after turning on Cloudflare Access for the site
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "observability": { "enabled": true }
}
