{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-farm",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ingest/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-farm",
      // replace with the id printed by: npx wrangler d1 create agent-farm
      "database_id": "ef88b806-1b40-4fdd-b7b4-a00f3c94af0c",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "STALL_MINUTES": "30",
    "AUTO_HARVEST_HOURS": "24",
    // fill these two after turning on Cloudflare Access for the site
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "observability": { "enabled": true }
}
